{
  "name": "dsh-uiux",
  "version": "0.7.1",
  "private": true,
  "description": "Design-direction plugin for DeepSeek Harness: named visual styles with implementation-ready tokens, platform guidance, a review rubric, and a live preview tab.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "data",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'tests/*.test.js'",
    "validate": "node scripts/validate.mjs && node scripts/build-index.mjs --check",
    "build:briefs": "node scripts/convert-brief.mjs && node scripts/build-index.mjs",
    "vendor": "node scripts/vendor.mjs",
    "build:index": "node scripts/build-index.mjs",
    "build:examples": "node scripts/build-examples.mjs",
    "examples": "node scripts/build-examples.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {
    "modern-web-guidance": "^1.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": true
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "icon": "./icon.svg"
}
