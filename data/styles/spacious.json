  "rules": {
    "do": [
      "Let whitespace carry the layout: 96 to 160px between sections, 32px inside cards.",
      "Keep one column and a generous outer margin; never fill the width because you can.",
      "Use hairlines and small tracked labels instead of boxes and borders."
    ],
    "dont": [
      "Do not add an element to balance empty space.",
      "Do not use more than one accent, and prefer none at all.",
      "Do not set body copy under 17px."
    ],
    "antiPatterns": [
      "Dense grids with 8px gutters in a calm layout.",
      "A coloured hero behind an airy page.",
      "Borders on every card because the whitespace felt unfinished."
    ]
  }
